			)
			(justify left top)
		)
		(uuid "1e9263e1-d358-4384-aafe-ebe7d1cce42e")
	)
	(text "Large C_n here\ndoes not degrade\ncircuit performance\nin any way"
		(exclude_from_sim no)
		(at 183.388 81.534 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30e49e16-46cc-4245-9940-a6dade4c1cce")
	)
	(text "close to a decision:\npower supplies: exactly 170 V\ntarget amplitude: 165 V\nG_pre (OPA828) = 13.5 / 5 = -2.7\nG_post (PA97) = 170 / 12.5 = -13.6\nfine Z channel in OPA828 passes through -1.0 gain"
		(exclude_from_sim no)
		(at 170.434 27.178 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5a6ebcb2-09e5-4540-a7b1-c4771e2c7e3e")
	)
	(text ".control\nset controlswait\n\nmeas tran dynamic_tfall5 TRIG v(/piezo/pos_unfiltered) VAL=142.1 FALL=1 TARG v(/piezo/pos_unfiltered) VAL=-86.4 FALL=1\nmeas tran dynamic_trise5 TRIG v(/piezo/pos_unfiltered) VAL=-139.1 RISE=1 TARG v(/piezo/pos_unfiltered) VAL=89.4 RISE=1\nmeas tran Vmin min v(/piezo/pos_unfiltered) from=1u to=60u\nmeas tran Vmax max v(/piezo/pos_unfiltered) from=1u to=60u\n.endc\n"
		(exclude_from_sim no)
		(at 23.368 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5cd9e068-5510-4092-bbfa-f26fdd738b4f")
	)
	(text "500 nV/sqrt(Hz)"
		(exclude_from_sim no)
		(at 158.75 138.938 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
