	)
	(text "current limit\n\nsafe vs. design requirement\nmaster: 15 Ω / 6 Ω\nslave: 12 Ω / 5 Ω\n\nstart with the safe values for an initial test,\nupgrade to the smaller resistances afterward,\ndesign board to easily replace fried amplifiers\n\norder the following parts:\n15, 10, 6 Ω\n12, 8.66, 5 Ω"
		(exclude_from_sim no)
		(at 231.648 16.002 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ccac41a3-dbeb-43e0-81d9-eca7462d994b")
	)
