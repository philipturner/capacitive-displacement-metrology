	(text "Rf: 1206 or 1210 resistor\nkeepout zone on closest inner copper layer\nto make capacitance closer to expectation"
		(exclude_from_sim no)
		(at 170.434 15.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1e9263e1-d358-4384-aafe-ebe7d1cce42e")
	)
	(text "close to a decision:\npower supplies: exactly 170 V\ntarget amplitude: 165 V\nG_pre (OPA828) = 13.5 / 5 = -2.7\nG_post (PA97) = 170 / 12.5 = -13.6\nfine Z channel in OPA828 passes through -1.0 gain"
		(exclude_from_sim no)
		(at 170.434 27.178 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5a6ebcb2-09e5-4540-a7b1-c4771e2c7e3e")
	)
	(text "effect of gain on stability\n\n[C_f = 0.2 pF, C_c = 2.2 pF]\nno capacitive load: overshoot vanishes at G > 12.5\n- no R_n and C_n needed on master\n- 50k and 0.01-0.07n on slave\n- 40k and 0.02-0.10n on slave\n- 30k and 0.03-0.15n on slave\n- 20k and 0.04-0.20n on slave\nwith piezo:\n\n[C_f = 0.5 pF, C_c = 2.2 pF]\nno capacitive load: overshoot vanishes at G > 4.0\n- 70k and 3-30p\n- 50k and 7-40p\n- 20k and 30-150p\n\n[C_f = 0.2 pF, C_c = 10 pF]\nno capacitive load: overshoot vanishes at G > 5.7\n- 100k and 0.01-0.06n\n- 50k and 0.03-0.13n\n\n[C_f = 0.5 pF, C_c = 10 pF]\nno capacitive load: overshoot vanishes at G > 4.4\n- 130k and 5-30p\n- 70k and 9-60p\nwith piezo: overshoot never vanishes\n- G_m = 10, G_s = 8, C_n = 0.08n\nnone of these are oscillations, just messy settling in <10 μs"
		(exclude_from_sim no)
		(at 22.606 92.202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7d1cdc54-9514-4a4a-8a7e-1bda86ec8858")
	)
	(text "current limit\n\nsafe vs. design requirement\nmaster: 15 Ω / 6 Ω\nslave: 12 Ω / 5 Ω\n\nstart with the safe values for an initial test,\nupgrade to the smaller resistances afterward,\ndesign board to easily replace fried amplifiers"
		(exclude_from_sim no)
		(at 231.648 16.002 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ccac41a3-dbeb-43e0-81d9-eca7462d994b")
	)
